---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  title?: string;
}

const { title = "Md. Mizanur Rahaman" } = Astro.props;
---
<!-- Mobile sticky top header -->
<header class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-zinc-200 dark:border-zinc-800 bg-[var(--surface)]/85 px-4 backdrop-blur-md md:hidden">
  <button
    type="button"
    data-nav-open
    aria-label="Open menu"
    class="btn btn-secondary grid size-9 place-items-center rounded-full"
  >
    <span class="btn-content">
      <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </span>
  </button>

  <div class="flex items-center gap-2">
    <ThemeToggle />
    <a
      href="/contact"
      data-sfx="pop"
      class="btn btn-primary h-8 px-3.5 rounded-xl text-xs font-semibold whitespace-nowrap"
    >
      <span class="btn-content">Contact</span>
    </a>
  </div>
</header>

<!-- Desktop sticky top bar -->
<div class="sticky top-0 z-20 hidden md:flex h-17.5 items-center justify-between gap-3 border-b border-zinc-200 dark:border-zinc-800 bg-[var(--surface)]/80 px-6 backdrop-blur-md lg:px-8">
  <div class="flex items-center gap-3 min-w-0">
    <!-- Small avatar icon -->
    <div class="size-9 rounded-full ring-2 ring-emerald-500/30 overflow-hidden bg-gradient-to-tr from-emerald-600 to-teal-400 grid place-items-center text-white font-bold text-sm shrink-0">
      MR
    </div>
    
    <div class="min-w-0 flex-1 leading-tight">
      <p class="flex items-center gap-1.5 truncate text-base font-semibold text-zinc-900 dark:text-zinc-100">
        <span>Md. Mizanur Rahaman</span>
        <!-- Rosette Verified Checkmark Badge -->
        <svg class="size-4.5 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.01 2.011a3.2 3.2 0 0 1 2.113.797l.154.145.698.698a1.2 1.2 0 0 0 .71.341L15.82 4h1a3.2 3.2 0 0 1 3.195 3.018l.005.182v1c0 .27.092.533.258.743l.09.1.697.698a3.2 3.2 0 0 1 .147 4.382l-.145.154-.698.698a1.2 1.2 0 0 0-.341.71l-.008.135v1a3.2 3.2 0 0 1-3.018 3.195l-.182.005h-1a1.2 1.2 0 0 0-.743.258l-.1.09-.698.697a3.2 3.2 0 0 1-4.382.147l-.154-.145-.698-.698a1.2 1.2 0 0 0-.71-.341L8.2 20.02h-1a3.2 3.2 0 0 1-3.195-3.018L4 16.82v-1a1.2 1.2 0 0 0-.258-.743l-.09-.1-.697-.698a3.2 3.2 0 0 1-.147-4.382l.145-.154.698-.698a1.2 1.2 0 0 0 .341-.71L4 8.2v-1l.005-.182a3.2 3.2 0 0 1 3.013-3.013L7.2 4h1a1.2 1.2 0 0 0 .743-.258l.1-.09.698-.697a3.2 3.2 0 0 1 2.269-.944m3.697 7.282a1 1 0 0 0-1.414 0L11 12.585l-1.293-1.292l-.094-.083a1 1 0 0 0-1.32 1.497l2 2l.094.083a1 1 0 0 0 1.32-.083l4-4l.083-.094a1 1 0 0 0-.083-1.32"/>
        </svg>
      </p>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 truncate">
        White Label SEO & AI Search (GEO/AEO) Strategist
      </p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <!-- Share button -->
    <button
      type="button"
      data-share
      aria-label="Share profile"
      class="btn btn-secondary grid size-10 place-items-center rounded-xl"
      title="Share profile"
    >
      <span class="btn-content">
        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
          <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
        </svg>
      </span>
    </button>

    <!-- Get in touch CTA -->
    <a
      href="/contact"
      data-sfx="pop"
      class="btn btn-primary h-10 px-4.5 rounded-xl text-sm font-semibold whitespace-nowrap"
    >
      <span class="btn-content inline-flex items-center gap-2">
        <span>Get in touch</span>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" x2="19" y1="12" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </a>
  </div>
</div>
