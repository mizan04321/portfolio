---
import LocalClock from './LocalClock.astro';
---
<aside class="sticky top-0 hidden min-h-dvh w-80 shrink-0 self-start border-l border-zinc-200 dark:border-zinc-800 lg:block xl:w-88 bg-[var(--surface)]" data-rail>
  <!-- Sticky Top Bar -->
  <div class="sticky top-0 z-10 flex h-17.5 items-center justify-between gap-3 border-b border-zinc-200 dark:border-zinc-800 bg-[var(--surface)]/85 px-6 backdrop-blur-md">
    <div class="flex items-center gap-2">
      <span class="relative flex size-2.5">
        <span class="absolute inline-flex size-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-emerald-600 dark:bg-emerald-500"></span>
      </span>
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Available</span>
    </div>

    <a
      href="https://www.linkedin.com/in/mizan-seo/"
      target="_blank"
      rel="noopener"
      data-sfx="sparkle"
      class="btn btn-inverse h-9 px-4 rounded-xl text-xs font-semibold inline-flex items-center gap-2"
    >
      <span class="btn-content inline-flex items-center gap-1.5">
        <svg class="size-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.95 0-1.72.77-1.72 1.72s.77 1.72 1.72 1.72 1.72-.77 1.72-1.72-.77-1.72-1.72-1.72Z"/>
        </svg>
        Connect
      </span>
    </a>
  </div>

  <div class="space-y-6 px-6 py-6">
    <!-- Quick Contact Card -->
    <div class="card-raised p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
          <svg class="size-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Direct Reach
        </h3>
        <span class="text-xs text-zinc-400">6–8 hrs/day</span>
      </div>

      <div class="space-y-2 text-xs">
        <a
          href="https://wa.me/8801688327756"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-between p-2.5 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-colors group"
        >
          <span class="flex items-center gap-2 text-zinc-700 dark:text-zinc-300">
            <span class="size-2 rounded-full bg-emerald-500"></span>
            WhatsApp
          </span>
          <span class="font-mono text-emerald-700 dark:text-emerald-400 group-hover:underline">+8801688327756</span>
        </a>

        <a
          href="mailto:mizanmahmudseo@gmail.com"
          class="flex items-center justify-between p-2.5 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-colors group"
        >
          <span class="flex items-center gap-2 text-zinc-700 dark:text-zinc-300">
            <span class="size-2 rounded-full bg-blue-500"></span>
            Email
          </span>
          <span class="truncate max-w-[130px] font-mono text-zinc-600 dark:text-zinc-400 group-hover:text-emerald-600">mizanmahmudseo</span>
        </a>
      </div>

      <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs text-zinc-500">
        <span>Local Time (GMT+6)</span>
        <LocalClock showIcon={false} />
      </div>
    </div>

    <!-- Impact Numbers Card -->
    <div class="card-raised p-5 space-y-4">
      <h3 class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <svg class="size-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
          <polyline points="16 7 22 7 22 13"></polyline>
        </svg>
        Proven Results
      </h3>

      <div class="grid grid-cols-2 gap-3">
        <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 border border-zinc-200/50 dark:border-zinc-700/50">
          <p class="text-xl font-bold tracking-tight text-emerald-700 dark:text-emerald-400">1,200+</p>
          <p class="text-[11px] text-zinc-500 leading-tight mt-0.5">Calls in 5 mos via GBP</p>
        </div>

        <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 border border-zinc-200/50 dark:border-zinc-700/50">
          <p class="text-xl font-bold tracking-tight text-emerald-700 dark:text-emerald-400">30+</p>
          <p class="text-[11px] text-zinc-500 leading-tight mt-0.5">Managed SEO Projects</p>
        </div>

        <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 border border-zinc-200/50 dark:border-zinc-700/50">
          <p class="text-xl font-bold tracking-tight text-emerald-700 dark:text-emerald-400">3×</p>
          <p class="text-[11px] text-zinc-500 leading-tight mt-0.5">Organic Rank Growth</p>
        </div>

        <div class="p-3 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 border border-zinc-200/50 dark:border-zinc-700/50">
          <p class="text-xl font-bold tracking-tight text-emerald-700 dark:text-emerald-400">1.9K+</p>
          <p class="text-[11px] text-zinc-500 leading-tight mt-0.5">Shopify Clicks (3 mos)</p>
        </div>
      </div>
    </div>

    <!-- Top Certifications Widget -->
    <div class="card-raised p-5 space-y-3">
      <h3 class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <svg class="size-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="7"></circle>
          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
        </svg>
        Industry Credentials
      </h3>

      <ul class="space-y-2 text-xs">
        <li class="flex items-start gap-2 text-zinc-700 dark:text-zinc-300">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
          <span><strong>Semrush:</strong> Advanced Technical SEO & Fundamentals</span>
        </li>
        <li class="flex items-start gap-2 text-zinc-700 dark:text-zinc-300">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
          <span><strong>Udemy:</strong> Page-One Results AEO & GEO</span>
        </li>
        <li class="flex items-start gap-2 text-zinc-700 dark:text-zinc-300">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
          <span><strong>Schema App:</strong> Schema.org Implementation Specialist</span>
        </li>
        <li class="flex items-start gap-2 text-zinc-700 dark:text-zinc-300">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
          <span><strong>BrightLocal:</strong> Local SEO Fundamentals</span>
        </li>
      </ul>
    </div>
  </div>
</aside>
