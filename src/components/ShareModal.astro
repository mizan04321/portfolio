<!-- Toast notification for link copied -->
<div
  id="share-toast"
  class="fixed bottom-6 right-6 z-50 transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300 ease-out flex items-center gap-3 px-4 py-3 rounded-2xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-2xl border border-zinc-700/40 text-sm font-medium"
  role="alert"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="size-4.5 text-emerald-400 dark:text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
  <span>Portfolio link copied to clipboard!</span>
</div>

<script>
  function setupShareButtons() {
    const shareBtns = document.querySelectorAll('[data-share]');
    const toast = document.getElementById('share-toast');

    shareBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (window.playSfx) window.playSfx('sparkle');
        
        const url = window.location.href;
        if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(url);
            showToast();
            return;
          } catch (e) {
            // fallback
          }
        }
        
        // Native share if supported
        if (navigator.share) {
          try {
            await navigator.share({
              title: 'Md. Mizanur Rahaman - White Label SEO Strategist',
              url: url,
            });
          } catch (e) {}
        } else {
          showToast();
        }
      });
    });

    function showToast() {
      if (!toast) return;
      toast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3000);
    }
  }

  setupShareButtons();
  document.addEventListener('astro:after-swap', setupShareButtons);
</script>
