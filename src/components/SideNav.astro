---
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  {
    name: 'Profile',
    href: '/',
    exact: true,
    icon: `<svg class="size-5 shrink-0 transition-transform group-active:scale-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
  {
    name: 'Case Studies',
    href: '/work',
    icon: `<svg class="size-5 shrink-0 transition-transform group-active:scale-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`
  },
  {
    name: 'Services',
    href: '/services',
    icon: `<svg class="size-5 shrink-0 transition-transform group-active:scale-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`
  },
  {
    name: 'Vibe Coding',
    href: '/vibe-coding',
    icon: `<svg class="size-5 shrink-0 transition-transform group-active:scale-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/></svg>`
  },
  {
    name: 'Contact',
    href: '/contact',
    icon: `<svg class="size-5 shrink-0 transition-transform group-active:scale-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`
  }
];

function isActive(itemHref: string, exact?: boolean) {
  if (exact) {
    return currentPath === itemHref || currentPath === itemHref + '/';
  }
  return currentPath.startsWith(itemHref);
}
---

<aside class="sticky top-0 hidden h-dvh w-19 shrink-0 flex-col items-center px-3 pt-5 pb-5 transition-[width] duration-200 md:flex xl:w-65 xl:items-stretch xl:px-4 xl:collapsed:w-19 xl:collapsed:items-center xl:collapsed:px-3 border-r border-zinc-200 dark:border-zinc-800 bg-[var(--surface)]">

  <!-- Navigation items -->
  <nav class="mt-3 flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto [scrollbar-width:none]" aria-label="Main Navigation">
    <div class="flex flex-col gap-1">
      {navItems.map((item) => {
        const active = isActive(item.href, item.exact);
        return (
          <a
            href={item.href}
            title={item.name}
            data-sfx="pop"
            class={`group flex items-center gap-3.5 rounded-xl p-3 text-sm transition-colors xl:px-3.5 xl:py-2.5 xl:collapsed:p-3 ${
              active
                ? 'bg-zinc-100/90 dark:bg-zinc-800/80 font-semibold text-emerald-700 dark:text-emerald-400 shadow-xs'
                : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-900 dark:hover:text-zinc-100'
            }`}
          >
            <Fragment set:html={item.icon} />
            <span class="sr-only xl:not-sr-only xl:collapsed:sr-only font-medium tracking-tight">
              {item.name}
            </span>
          </a>
        );
      })}
    </div>

    <!-- Quick Links divider -->
    <div class="flex flex-col gap-1">
      <hr class="mx-auto mb-2 w-6 border-zinc-200 dark:border-zinc-800 xl:mx-3 xl:w-auto xl:collapsed:mx-auto xl:collapsed:w-6" aria-hidden="true" />
      
      <a
        href="https://www.linkedin.com/in/mizan-seo/"
        target="_blank"
        rel="noopener"
        title="LinkedIn Profile"
        class="group flex items-center gap-3.5 rounded-xl p-3 text-sm transition-colors xl:px-3.5 xl:py-2.5 xl:collapsed:p-3 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64c-.95 0-1.72.77-1.72 1.72s.77 1.72 1.72 1.72 1.72-.77 1.72-1.72-.77-1.72-1.72-1.72Z"/>
        </svg>
        <span class="sr-only xl:not-sr-only xl:collapsed:sr-only font-medium">LinkedIn</span>
      </a>

      <a
        href="https://wa.me/8801688327756"
        target="_blank"
        rel="noopener"
        title="Chat on WhatsApp"
        class="group flex items-center gap-3.5 rounded-xl p-3 text-sm transition-colors xl:px-3.5 xl:py-2.5 xl:collapsed:p-3 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        <svg class="size-5 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.19.53-1.1 1.04-1.52 1.09-.4.05-.91.07-2.68-.66-2.14-.88-3.51-3.06-3.62-3.21-.1-.14-.87-1.16-.87-2.22 0-1.05.55-1.57.75-1.79.19-.21.42-.26.56-.26.14 0 .28 0 .4.01.13.01.3-.05.47.36.19.45.63 1.54.69 1.65.05.11.08.24.01.38-.07.14-.11.23-.21.35-.11.12-.22.27-.32.36-.11.1-.22.21-.1.41.13.22.56.93 1.21 1.51.83.74 1.53.97 1.75 1.08.22.11.35.09.48-.05.13-.14.56-.65.71-.88.15-.22.3-.19.51-.11.21.08 1.34.63 1.57.75.23.11.38.17.44.27.06.09.06.55-.13 1.08Z"/>
        </svg>
        <span class="sr-only xl:not-sr-only xl:collapsed:sr-only font-medium">WhatsApp</span>
      </a>
    </div>
  </nav>

  <!-- Bottom toggles and copyright -->
  <div class="mt-4 flex shrink-0 flex-col items-center gap-3 xl:items-start xl:px-2 xl:collapsed:items-center xl:collapsed:px-0 pt-3 border-t border-zinc-200 dark:border-zinc-800">
    <div class="flex flex-col gap-2 xl:flex-row xl:collapsed:flex-col">
      <ThemeToggle />
      <SoundToggle />
      
      <!-- Collapse toggle button -->
      <button
        type="button"
        data-sidebar-toggle
        aria-label="Toggle sidebar collapse"
        class="btn btn-secondary grid size-9 place-items-center rounded-full"
        title="Toggle sidebar collapse"
      >
        <span class="btn-content grid place-items-center">
          <!-- Expand icon -->
          <svg class="size-4.5 xl:hidden xl:collapsed:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m14 10 2 2-2 2"/>
          </svg>
          <!-- Collapse icon -->
          <svg class="hidden size-4.5 xl:block xl:collapsed:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 10-2 2 2 2"/>
          </svg>
        </span>
      </button>
    </div>
    
    <p class="hidden text-xs text-zinc-400 dark:text-zinc-500 xl:block xl:collapsed:hidden">
      © 2026 Md. Mizanur Rahaman
    </p>
  </div>
</aside>

<!-- Mobile Navigation Drawer -->
<dialog id="mobile-drawer" class="drawer fixed inset-y-0 left-0 z-50 m-0 h-full w-[min(19rem,85vw)] max-h-none bg-[var(--surface)] p-0 shadow-2xl border-r border-zinc-200 dark:border-zinc-800 backdrop:bg-black/60 backdrop:backdrop-blur-xs">
  <div class="flex h-full flex-col p-5">
    <div class="flex items-center justify-between pb-4 border-b border-zinc-200 dark:border-zinc-800">
      <span class="font-bold text-sm tracking-tight text-zinc-900 dark:text-zinc-100">Menu</span>
      <button type="button" data-nav-close aria-label="Close menu" class="btn btn-secondary grid size-8 place-items-center rounded-full">
        <span class="btn-content text-zinc-500">✕</span>
      </button>
    </div>

    <nav class="mt-4 flex flex-1 flex-col gap-1">
      {navItems.map((item) => {
        const active = isActive(item.href, item.exact);
        return (
          <a
            href={item.href}
            class={`flex items-center gap-3.5 rounded-xl px-3.5 py-3 text-sm font-medium transition-colors ${
              active
                ? 'bg-zinc-100 dark:bg-zinc-800 text-emerald-700 dark:text-emerald-400 font-semibold'
                : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50'
            }`}
          >
            <Fragment set:html={item.icon} />
            <span>{item.name}</span>
          </a>
        );
      })}

      <hr class="my-4 border-zinc-200 dark:border-zinc-800" />

      <a
        href="https://www.linkedin.com/in/mizan-seo/"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3.5 rounded-xl px-3.5 py-2.5 text-sm text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50"
      >
        <span>LinkedIn Profile</span>
      </a>
      <a
        href="https://wa.me/8801688327756"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3.5 rounded-xl px-3.5 py-2.5 text-sm text-emerald-600 dark:text-emerald-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50"
      >
        <span>Chat on WhatsApp</span>
      </a>
    </nav>

    <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
      <span class="text-xs text-zinc-400">© 2026 Mizanur Rahaman</span>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <SoundToggle />
      </div>
    </div>
  </div>
</dialog>

<script>
  function setupNavHandlers() {
    // Sidebar collapse toggle
    const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
    sidebarToggle?.addEventListener('click', () => {
      const root = document.documentElement;
      const isCollapsed = root.dataset.sidebar === 'collapsed';
      if (isCollapsed) {
        delete root.dataset.sidebar;
        localStorage.removeItem('sidebar');
      } else {
        root.dataset.sidebar = 'collapsed';
        localStorage.setItem('sidebar', 'collapsed');
      }
      if (window.playSfx) window.playSfx('click');
    });

    // Mobile drawer
    const drawer = document.getElementById('mobile-drawer') as HTMLDialogElement | null;
    const openBtns = document.querySelectorAll('[data-nav-open]');
    const closeBtns = document.querySelectorAll('[data-nav-close]');

    openBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        drawer?.showModal();
        if (window.playSfx) window.playSfx('pop');
      });
    });

    closeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        drawer?.close();
        if (window.playSfx) window.playSfx('click');
      });
    });

    drawer?.addEventListener('click', (e) => {
      if (e.target === drawer) {
        drawer.close();
      }
    });
  }

  setupNavHandlers();
  document.addEventListener('astro:after-swap', setupNavHandlers);
</script>
