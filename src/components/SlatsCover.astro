---
---
<div class="relative overflow-hidden h-36 sm:h-52 select-none border-b border-zinc-200 dark:border-zinc-800">
  <div class="cover absolute inset-0" aria-hidden="true">
    <!-- Floating mesh gradient blobs -->
    <span class="cover-blob" style="--blob: var(--cover-1); top: -45%; left: -12%; --dur: 24s; --delay: 0s;"></span>
    <span class="cover-blob" style="--blob: var(--cover-2); top: 15%; left: 8%; --dur: 27s; --delay: -4s;"></span>
    <span class="cover-blob" style="--blob: var(--cover-3); top: -35%; left: 32%; --dur: 29s; --delay: -8s;"></span>
    <span class="cover-blob" style="--blob: var(--cover-4); top: 5%; left: 55%; --dur: 23s; --delay: -12s;"></span>
    <span class="cover-blob" style="--blob: var(--cover-5); top: -30%; left: 76%; --dur: 31s; --delay: -6s;"></span>
    <span class="cover-blob" style="--blob: var(--cover-6); top: 45%; left: 38%; --dur: 33s; --delay: -16s; width: 45%;"></span>
  </div>

  <!-- Subtle grid/slats overlay pattern -->
  <div class="absolute inset-0 opacity-[0.07] dark:opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 18px 18px;"></div>
  
  <!-- Ambient bottom blur blend -->
  <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-[var(--surface)] to-transparent pointer-events-none"></div>
</div>
