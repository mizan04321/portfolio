  <!-- Interactive script for Read More toggle -->
  <script>
    function setupAboutToggle() {
      const btn = document.getElementById('about-toggle-btn');
      const expanded = document.getElementById('about-expanded');
      const text = document.getElementById('about-toggle-text');
      const icon = document.getElementById('about-toggle-icon');

      btn?.addEventListener('click', () => {
        if (!expanded || !text || !icon) return;
        const isOpen = !expanded.classList.contains('hidden');
        if (isOpen) {
          expanded.classList.add('hidden');
          text.textContent = 'Read more';
          icon.style.transform = 'rotate(0deg)';
        } else {
          expanded.classList.remove('hidden');
          text.textContent = 'Read less';
          icon.style.transform = 'rotate(180deg)';
        }
        if (window.playSfx) window.playSfx('click');
      });
    }

    setupAboutToggle();
    document.addEventListener('astro:after-swap', setupAboutToggle);
  </script>
