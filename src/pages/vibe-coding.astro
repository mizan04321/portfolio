---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SlatsCover from '../components/SlatsCover.astro';

// ============================================================================
// 💡 HOW TO ADD A NEW PROJECT:
// Simply add a new object to this array with:
//   1. name: "Your Project Name"
//   2. description: "A concise 1-2 sentence description"
//   3. liveUrl: "https://your-project-link.com"
// ============================================================================

interface VibeProject {
  name: string;
  description: string;
  liveUrl: string;
}

const projects: VibeProject[] = [
  {
    name: "AI Entity & Schema Generator",
    description: "An automated web tool that extracts brand identity and structures Schema.org JSON-LD markup optimized for Google AI Overviews and answer engines.",
    liveUrl: "https://schema-generator-demo.vercel.app"
  },
  {
    name: "Local Falcon Geo-Grid Rank Visualizer",
    description: "Interactive local ranking tracker that scans Google Maps 3-Pack rankings and generates visual geo-grid heatmaps for local businesses.",
    liveUrl: "https://rank-grid-demo.vercel.app"
  },
  {
    name: "White-Label SEO Client Report Builder",
    description: "Agency dashboard that aggregates Google Search Console, GA4, and GBP metrics into branded, executive-ready performance summaries.",
    liveUrl: "https://report-builder-demo.vercel.app"
  },
  {
    name: "Personal Portfolio & Interactive Resume",
    description: "Modern portfolio built with Astro 5, Tailwind CSS, View Transitions, Web Audio sound effects, and dark/light mode persistence.",
    liveUrl: "https://mizanur.me"
  }
];
---

<BaseLayout
  title="Vibe Coding Projects · Md. Mizanur Rahaman"
  description="Explore software, web apps, and tools built with AI coding workflows. Direct live project links and descriptions."
  currentPath="/vibe-coding"
>
  <Header />
  <SlatsCover />

  <!-- Page Header -->
  <section class="px-4 pt-8 text-center sm:px-6 lg:px-8">
    <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400 ring-1 ring-emerald-500/25 mb-3">
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping"></span>
        <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
      </span>
      <span>Built with AI Tools &amp; LLMs</span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Vibe Coding Projects
    </h1>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
      Software tools, dashboards, and client automations engineered using natural language prompts, AI models, and rapid agentic development.
    </p>
  </section>

  <!-- Navigation Tabs -->
  <nav class="mt-8 border-b border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 lg:px-8" aria-label="Profile tabs">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 sm:gap-x-8">
      <li>
        <a href="/" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Resume
        </a>
      </li>
      <li>
        <a href="/work" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Case Studies &amp; Results
        </a>
      </li>
      <li>
        <a href="/services" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Services
        </a>
      </li>
      <li>
        <a href="/vibe-coding" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-emerald-700 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400">
          Vibe Coding
        </a>
      </li>
      <li>
        <a href="/contact" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Contact
        </a>
      </li>
    </ul>
  </nav>

  <!-- Projects Grid -->
  <div class="px-4 py-10 sm:px-6 lg:px-8 space-y-10">
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((project, index) => (
        <article class="halo" data-halo>
          <div class="halo-glow" aria-hidden="true"></div>
          <div class="glass p-6 sm:p-7 rounded-2xl h-full flex flex-col justify-between space-y-5">
            <div class="halo-spot" aria-hidden="true"></div>

            <div class="space-y-3">
              <!-- Top Counter & Tag -->
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400">
                  PROJECT 0{index + 1}
                </span>
                <span class="badge text-xs font-medium">
                  Live
                </span>
              </div>

              <!-- 1. Project Name -->
              <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                {project.name}
              </h2>

              <!-- 2. Short Description -->
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {project.description}
              </p>
            </div>

            <!-- 3. Live Project URL Button -->
            <div class="pt-2 border-t border-zinc-200 dark:border-zinc-800">
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-sfx="pop"
                class="btn btn-secondary h-10 px-4.5 rounded-xl text-xs sm:text-sm font-semibold inline-flex items-center justify-between w-full group/btn"
              >
                <span class="btn-content inline-flex items-center justify-between w-full">
                  <span class="truncate max-w-[200px] sm:max-w-[240px] text-zinc-800 dark:text-zinc-200 font-mono text-xs">
                    {project.liveUrl.replace(/^https?:\/\//, '')}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400 font-semibold shrink-0">
                    <span>Visit Live</span>
                    <svg class="size-3.5 transition-transform group-hover/btn:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </span>
                </span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Easy Add Helper Guide Card -->
    <div class="card-raised p-6 sm:p-7 space-y-3">
      <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-bold text-sm">
        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Easy to Add More Projects</span>
      </div>

      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
        To add a new project, open <code class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-xs text-emerald-700 dark:text-emerald-400">src/pages/vibe-coding.astro</code> and add an object to the <code class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-xs">projects</code> array:
      </p>

      <pre class="p-3.5 rounded-xl bg-zinc-950 text-zinc-200 font-mono text-xs overflow-x-auto border border-zinc-800"><code>&#123;
  name: "My Next Project",
  description: "Short description of what the project does...",
  liveUrl: "https://my-live-project.com"
&#125;</code></pre>
    </div>
  </div>
</BaseLayout>
