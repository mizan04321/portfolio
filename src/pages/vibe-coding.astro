---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SlatsCover from '../components/SlatsCover.astro';

// ============================================================================
// 💡 HOW TO ADD A NEW PROJECT:
// Simply add a new object to this array with:
//   1. name: "Your Project Name"
//   2. description: "A concise 1-2 sentence description"
//   3. liveUrl: "https://your-project-link.com"
// Optional fields:
//   - badge: "📈 $120K+ raised" or "⚡ AI Tool"
//   - badgeIcon: true (shows trending arrow)
//   - logoText: "B", "Invo", "{}" (defaults to initials of name if omitted)
//   - tags: ["SaaS", "Productivity"]
//   - stars: 185
// ============================================================================

interface VibeProject {
  name: string;
  description: string;
  liveUrl: string;
  badge?: string;
  badgeIcon?: boolean;
  logoText?: string;
  tags?: string[];
  stars?: number | string;
}

const projects: VibeProject[] = [
  {
    name: "Bidvers",
    description: "Core platform and API behind a real-time hotel upgrade bidding marketplace",
    liveUrl: "https://bidvers.com",
    badge: "$120K+ raised",
    badgeIcon: true,
    logoText: "B",
    tags: ["Laravel", "API", "Real-time"]
  },
  {
    name: "Learn Laravel",
    description: "Self-learning resources to level up your Laravel skills: tutorials, ebooks, blogs and courses",
    liveUrl: "https://learnlaravel.com",
    logoText: "L",
    tags: ["Open source", "Laravel", "Learning"],
    stars: 185
  },
  {
    name: "Invo",
    description: "Effortless invoice management, no sign-up needed",
    liveUrl: "https://invo.app",
    logoText: "Invo",
    tags: ["SaaS", "Productivity"],
    stars: 5
  },
  {
    name: "Prompt Filler",
    description: "Fill prompt placeholders as easily as filling a form",
    liveUrl: "https://promptfiller.com",
    logoText: "{}",
    tags: ["DevTool", "SaaS", "Productivity"],
    stars: 2
  },
  {
    name: "AI Entity & Schema Generator",
    description: "Automated schema builder extracting brand knowledge graphs and structuring JSON-LD for AI Overviews & answer engines",
    liveUrl: "https://schema-generator-demo.vercel.app",
    badge: "GEO / AEO",
    badgeIcon: true,
    logoText: "AI",
    tags: ["AI Search", "Schema.org", "Next.js"],
    stars: 14
  },
  {
    name: "Local Falcon Rank Grid Visualizer",
    description: "Interactive geo-grid dashboard displaying Google Maps 3-Pack rank heatmaps and competitor positioning",
    liveUrl: "https://rank-grid-demo.vercel.app",
    badge: "Local SEO",
    logoText: "LF",
    tags: ["Maps 3-Pack", "Geo-Grid", "API"],
    stars: 9
  }
];
---

<BaseLayout
  title="Vibe Coding Projects · Md. Mizanur Rahaman"
  description="Products I've designed, built and shipped, plus the open source work behind them."
  currentPath="/vibe-coding"
>
  <Header />
  <SlatsCover />

  <!-- Page Header matching Nahian style -->
  <section class="px-4 pt-8 text-center sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Projects
    </h1>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
      Products I’ve designed, built and shipped, plus the open source work behind them.
    </p>
  </section>

  <!-- Navigation Tabs -->
  <nav class="mt-8 border-b border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 lg:px-8" aria-label="Profile tabs">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 sm:gap-x-8">
      <li>
        <a href="/" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Resume
        </a>
      </li>
      <li>
        <a href="/work" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Case Studies &amp; Results
        </a>
      </li>
      <li>
        <a href="/services" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Services
        </a>
      </li>
      <li>
        <a href="/vibe-coding" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-emerald-700 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400">
          Vibe Coding
        </a>
      </li>
      <li>
        <a href="/contact" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Contact
        </a>
      </li>
    </ul>
  </nav>

  <!-- Projects Grid (Exact Nahian Card Style) -->
  <div class="px-4 py-10 sm:px-6 lg:px-8 space-y-10">
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-sfx="pop"
          class="project-card p-3 sm:p-3.5 group cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500"
          title={`Visit ${project.name}`}
        >
          <!-- Top Banner with Emerald Glow & Dot Matrix -->
          <div class="project-banner">
            {project.badge && (
              <span class="project-badge-pill">
                {project.badgeIcon && (
                  <svg class="size-3 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                    <polyline points="16 7 22 7 22 13"/>
                  </svg>
                )}
                <span>{project.badge}</span>
              </span>
            )}

            <!-- Center Squircle Logo Badge -->
            <div class="project-logo-badge">
              <span class="font-black text-xl sm:text-2xl tracking-tight text-zinc-900 dark:text-white select-none">
                {project.logoText || project.name.slice(0, 2).toUpperCase()}
              </span>
            </div>
          </div>

          <!-- Bottom Details Area -->
          <div class="p-3 sm:p-3.5 flex-1 flex flex-col justify-between space-y-3">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  {project.name}
                </h2>
                <svg class="size-4 text-zinc-400 dark:text-zinc-500 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </div>

              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed line-clamp-2">
                {project.description}
              </p>
            </div>

            <!-- Bottom Row: Tags + Stars & GitHub -->
            <div class="pt-2 flex items-center justify-between gap-2 border-t border-zinc-100 dark:border-zinc-800/80">
              <div class="flex flex-wrap gap-1.5">
                {(project.tags || ["Project"]).map((tag) => (
                  <span class="rounded-md bg-zinc-100 dark:bg-zinc-800/90 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-400 border border-zinc-200/60 dark:border-zinc-700/60">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Right: Stars / GitHub indicator -->
              <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 font-mono shrink-0">
                {project.stars !== undefined && (
                  <span class="flex items-center gap-1 font-semibold">
                    <svg class="size-3.5 text-zinc-400 dark:text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    <span>{project.stars}</span>
                  </span>
                )}
                <svg class="size-3.5 hover:text-emerald-500 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Easy Add Helper Guide Card -->
    <div class="card-raised p-6 sm:p-7 space-y-3">
      <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-bold text-sm">
        <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>How to Add Your Own Projects</span>
      </div>

      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
        Open <code class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-xs text-emerald-700 dark:text-emerald-400">src/pages/vibe-coding.astro</code> and add your project to the <code class="px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-xs">projects</code> array:
      </p>

      <pre class="p-3.5 rounded-xl bg-zinc-950 text-zinc-200 font-mono text-xs overflow-x-auto border border-zinc-800"><code>&#123;
  name: "Your Project Name",
  description: "Short description of what the project does...",
  liveUrl: "https://your-project-link.com",
  badge: "📈 $120K+ raised", // optional
  logoText: "B",              // optional (defaults to initials)
  tags: ["Laravel", "API"]   // optional
&#125;</code></pre>
    </div>
  </div>
</BaseLayout>
