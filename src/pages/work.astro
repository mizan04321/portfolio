---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SlatsCover from '../components/SlatsCover.astro';

// ============================================================================
// 📷 HOW TO ADD OR REPLACE SCREENSHOTS:
// 1. Drop your PNG, JPG, or WebP screenshot files into: public/images/case-studies/
//    (Example: public/images/case-studies/my-gsc.png)
// 2. Update the 'image' property in the arrays below to your new filename.
// ============================================================================

interface CaseStudy {
  title: string;
  client: string;
  metric: string;
  timeframe: string;
  tags: string[];
  description: string;
  bullets: string[];
  image: string;
  imageLabel: string;
}

const caseStudies: CaseStudy[] = [
  {
    title: "Digital Products E-Commerce Growth (Shopify)",
    client: "Fanflix BD (Dhaka, Bangladesh)",
    metric: "300 → 1.9K+ Clicks",
    timeframe: "3 Months",
    tags: ["Shopify", "E-Commerce SEO", "Technical Audit", "Keyword Intent"],
    // Screenshot placeholder for this case study:
    image: "/images/case-studies/google-search-console.svg",
    imageLabel: "Google Search Console Proof",
    description: "Scaled a Shopify-based e-commerce store selling digital products from virtually zero search traffic to over 1,900 monthly organic clicks.",
    bullets: [
      "Conducted extensive search intent mapping to align commercial keywords with category and product URLs.",
      "Fixed crawl bloat, collection filter indexation, and implemented automated Product/Offer schema.",
      "Optimized product descriptions, meta tags, and internal link architecture to pass topical equity."
    ]
  },
  {
    title: "Multi-Location Healthcare SEO (7 Google Business Profiles)",
    client: "Confidential Healthcare Provider (UK)",
    metric: "7 GBPs Ranked Top 3",
    timeframe: "Ongoing Agency Lead",
    tags: ["Local SEO", "Multi-Location", "Google Business Profile", "Healthcare"],
    // Screenshot placeholder for this case study:
    image: "/images/case-studies/google-business-profile.svg",
    imageLabel: "Google Business Profile Proof",
    description: "Managed end-to-end local SEO for a UK-based healthcare business operating across 7 regional Google Business Profiles.",
    bullets: [
      "Standardized NAP (Name, Address, Phone) citations and implemented location-specific semantic entity signals.",
      "Built dedicated clinic service landing pages with local business schema connected directly to each GBP.",
      "Achieved dominant Google Maps 3-Pack visibility across primary UK target service areas, driving record patient inquiries."
    ]
  },
  {
    title: "UK Taxi Service: Technical SEO & Toxic Backlink Recovery",
    client: "Ramies Taxi (UK)",
    metric: "3× Organic Surge · Top 5 Rank",
    timeframe: "Jan 2025 – Jun 2025",
    tags: ["Technical SEO", "Penalty Recovery", "Screaming Frog", "Backlink Disavow"],
    // Screenshot placeholder for this case study:
    image: "/images/case-studies/map-rankings.svg",
    imageLabel: "Map Rankings Proof",
    description: "Diagnosed algorithmic suppression caused by legacy negative SEO attacks and technical site deficiencies.",
    bullets: [
      "Audited link profile with Semrush and GSC, identifying and preparing disavow documentation for 300+ toxic backlinks.",
      "Resolved Core Web Vitals bottlenecks, mobile layout shifts, and XML sitemap indexation conflicts.",
      "Reclaimed lost rankings, moving competitive regional taxi keywords from page 2 (10+ positions) into top 5 organic results."
    ]
  },
  {
    title: "Local SEO Lead Generation: UK Pharmacy & Houston Landscaping",
    client: "Local Service Businesses (UK & USA)",
    metric: "1,200+ Calls (UK) · 330 Calls/Mo (US)",
    timeframe: "Jan 2023 – Present",
    tags: ["Local SEO", "High-Intent Calls", "GBP Domination", "Conversion SEO"],
    // Screenshot placeholder for this case study:
    image: "/images/case-studies/leads.svg",
    imageLabel: "Leads & Calls Proof",
    description: "Implemented high-converting local search strategies built specifically to turn Google Maps searchers into immediate phone calls.",
    bullets: [
      "UK Pharmacy: Optimized categories, services, products, and Q&A to generate 1,200+ verified customer calls within 6 months.",
      "Houston Landscaping: Structured local radius citations and seasonal service clusters, delivering 330 calls in a single month.",
      "Oldham Chiropody Clinic: Overhauled underdeveloped GBP profile, securing direct booking appointments via Google profile actions."
    ]
  }
];

// 5 Dedicated Proof Categories requested for screenshot verification:
interface ProofSection {
  id: string;
  category: string;
  badge: string;
  title: string;
  subtitle: string;
  metric: string;
  metricLabel: string;
  description: string;
  image: string;
  alt: string;
  instructions: string;
}

const proofSections: ProofSection[] = [
  {
    id: "gsc",
    category: "Google Search Console",
    badge: "GSC Verified",
    title: "Google Search Console: Clicks, Impressions & Ranking Progression",
    subtitle: "Organic search visibility curve showing high-velocity click acquisition across competitive keywords",
    metric: "300 → 1.94K+",
    metricLabel: "Monthly Organic Clicks (+546% Growth)",
    description: "Verified GSC performance metrics demonstrating organic impressions surge from 17.5K to 84.2K+ following on-page entity restructuring and Schema.org JSON-LD alignment.",
    // Image placeholder path (replace this with your screenshot anytime):
    image: "/images/case-studies/google-search-console.svg",
    alt: "Google Search Console performance report showing organic clicks and impressions surge",
    instructions: "Replace with your GSC screenshot in public/images/case-studies/google-search-console.png"
  },
  {
    id: "gbp",
    category: "Google Business Profile",
    badge: "GBP Performance",
    title: "Google Business Profile: Customer Interactions & Call Volume",
    subtitle: "Google Maps discovery searches, direct click-to-call mobile conversions, and driving direction requests",
    metric: "1,200+ Calls",
    metricLabel: "Direct Phone Inquiries in 5 Months",
    description: "Google Business Profile performance report tracking client call inquiries surging from ~50 to over 1,200 calls through category optimization, geo-localized service pages, and review velocity.",
    // Image placeholder path:
    image: "/images/case-studies/google-business-profile.svg",
    alt: "Google Business Profile insights chart showing customer call growth",
    instructions: "Replace with your GBP screenshot in public/images/case-studies/google-business-profile.png"
  },
  {
    id: "map-rankings",
    category: "Map Rankings",
    badge: "Local 3-Pack Dominance",
    title: "Map Rankings: Geo-Grid Local Falcon Scan & Heatmaps",
    subtitle: "Multi-point radius scanning confirming #1 and #2 positions throughout primary business territory",
    metric: "#1.16 Avg",
    metricLabel: "Average Geo-Grid Rank Across Service Area",
    description: "Local Falcon 13x13 geo-grid heatmap scan documenting dominant #1 green ranking pins across city limits, capturing immediate high-intent local phone searches.",
    // Image placeholder path:
    image: "/images/case-studies/map-rankings.svg",
    alt: "Local Falcon geo-grid rankings scan showing #1 positions across city radius",
    instructions: "Replace with your Map Rankings screenshot in public/images/case-studies/map-rankings.png"
  },
  {
    id: "google-analytics",
    category: "Google Analytics",
    badge: "GA4 Traffic Data",
    title: "Google Analytics (GA4): Organic User Acquisition & Sessions",
    subtitle: "Audience traffic growth, active engagement duration, and qualified inbound user scale",
    metric: "14.8K Users",
    metricLabel: "+310% Active Organic Visitors",
    description: "Google Analytics 4 acquisition overview confirming steady month-over-month growth in organic sessions (22.4K) and high-intent engagement rates exceeding 62%.",
    // Image placeholder path:
    image: "/images/case-studies/google-analytics.svg",
    alt: "Google Analytics 4 traffic acquisition dashboard showing user growth",
    instructions: "Replace with your GA4 screenshot in public/images/case-studies/google-analytics.png"
  },
  {
    id: "leads",
    category: "Leads",
    badge: "Verified Conversions",
    title: "Leads: Inbound Phone Calls, Form Fills & Client ROI",
    subtitle: "Direct customer inquiries, appointment bookings, and bottom-line revenue pipeline attribution",
    metric: "1,530+ Leads",
    metricLabel: "Total Commercial Inquiries Logged",
    description: "Attribution log tracking verified phone call records, scheduled consultation forms, and quotation requests delivered directly to client CRM and communication systems.",
    // Image placeholder path:
    image: "/images/case-studies/leads.svg",
    alt: "Leads and customer conversion activity log",
    instructions: "Replace with your Leads screenshot in public/images/case-studies/leads.png"
  }
];
---

<BaseLayout
  title="Case Studies & Results · Md. Mizanur Rahaman"
  description="Proven SEO case studies: 300 to 1.9K+ Shopify clicks, 1,200+ calls for UK pharmacy, 300+ toxic backlink recovery, and multi-location GBP domination."
  currentPath="/work"
>
  <Header />
  <SlatsCover />

  <!-- Page Header Title -->
  <section class="px-4 pt-8 text-center sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Case Studies & Measurable Growth
    </h1>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
      Real client results demonstrating organic search revenue, Google Business Profile growth, and technical precision.
    </p>
  </section>

  <!-- Profile Tabs -->
  <nav class="mt-8 border-b border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 lg:px-8" aria-label="Profile tabs">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 sm:gap-x-8">
      <li>
        <a href="/" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Resume
        </a>
      </li>
      <li>
        <a href="/work" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-emerald-700 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400">
          Case Studies & Results
        </a>
      </li>
      <li>
        <a href="/services" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Services
        </a>
      </li>
      <li>
        <a href="/vibe-coding" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Vibe Coding
        </a>
      </li>
      <li>
        <a href="/contact" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Contact
        </a>
      </li>
    </ul>
  </nav>

  <div class="px-4 py-10 sm:px-6 lg:px-8 space-y-12">
    <!-- Section 1: Detailed Client Case Studies with Screenshot Previews -->
    <section aria-labelledby="client-studies-heading" class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 id="client-studies-heading" class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <svg class="size-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
            Featured Client Case Studies
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-0.5">
            Click any image or card to inspect screenshot details and performance metrics.
          </p>
        </div>

        <a href="#proof-gallery" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 hover:underline">
          <span>Jump to Analytics Dashboards</span>
          <span>↓</span>
        </a>
      </div>

      <!-- Case Studies 2x2 Grid -->
      <div class="grid gap-6 sm:grid-cols-2">
        {caseStudies.map((study) => (
          <article class="halo" data-halo>
            <div class="halo-glow" aria-hidden="true"></div>
            <div class="glass p-6 rounded-2xl h-full flex flex-col justify-between space-y-4">
              <div class="halo-spot" aria-hidden="true"></div>
              <div class="space-y-4">
                <!-- Header with Client & Timeframe -->
                <div class="flex items-start justify-between gap-3">
                  <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                    {study.client}
                  </span>
                  <span class="badge text-xs font-bold text-emerald-700 dark:text-emerald-400">
                    {study.timeframe}
                  </span>
                </div>

                <!-- Case Study Title -->
                <h3 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                  {study.title}
                </h3>

                <!-- Key Outcome Metric Banner -->
                <div class="p-3 rounded-xl bg-emerald-500/10 dark:bg-emerald-950/40 border border-emerald-500/20">
                  <p class="text-xs font-semibold text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5">
                    <svg class="size-4 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                      <polyline points="16 7 22 7 22 13"/>
                    </svg>
                    Key Outcome: <span class="font-extrabold text-sm">{study.metric}</span>
                  </p>
                </div>

                <!-- 📷 Case Study Screenshot Image Placeholder -->
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between text-[11px] font-semibold text-zinc-500 dark:text-zinc-400">
                    <span class="flex items-center gap-1">
                      <svg class="size-3.5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                      </svg>
                      {study.imageLabel}
                    </span>
                    <span class="text-emerald-700 dark:text-emerald-400 font-mono text-[10px]">Click to zoom</span>
                  </div>

                  <button
                    type="button"
                    class="group relative block w-full overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-950/50 text-left transition-all hover:border-emerald-500/50 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-zoom-in"
                    data-zoom-img={study.image}
                    data-zoom-title={`${study.title} · ${study.imageLabel}`}
                    data-zoom-caption={`${study.client} (${study.metric})`}
                    aria-label={`View full-size screenshot for ${study.title}`}
                  >
                    <!-- Aspect ratio wrapper -->
                    <div class="aspect-16/10 w-full overflow-hidden">
                      <img
                        src={study.image}
                        alt={`${study.title} verified metric proof`}
                        loading="lazy"
                        class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>

                    <!-- Subtle hover overlay badge -->
                    <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 backdrop-blur-[2px] transition-opacity group-hover:opacity-100">
                      <span class="btn btn-primary h-8 px-3 rounded-lg text-xs font-semibold shadow-lg">
                        <span class="btn-content inline-flex items-center gap-1.5">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/>
                          </svg>
                          Expand Screenshot
                        </span>
                      </span>
                    </div>
                  </button>
                </div>

                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                  {study.description}
                </p>

                <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 list-disc pl-5">
                  {study.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>

              <!-- Tags row -->
              <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-200 dark:border-zinc-800">
                {study.tags.map((tag) => (
                  <span class="rounded-md bg-zinc-100 dark:bg-zinc-800/80 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-400">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Section 2: Verified Analytics Proof & Image Placeholders (5 Key Sections Requested) -->
    <section id="proof-gallery" aria-labelledby="proof-heading" class="space-y-8 scroll-mt-20">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400 ring-1 ring-emerald-500/25">
          <span class="size-2 rounded-full bg-emerald-500"></span>
          Verified Performance Dashboards
        </div>
        <h2 id="proof-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Analytics Proof & Screenshot Showcase
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl">
          Visual evidence from production environments demonstrating quantifiable client growth across Google Search Console, Google Business Profile, Map Rankings, Google Analytics (GA4), and Inbound Lead Generation.
        </p>

        <!-- Quick Jump Navigation Pills -->
        <div class="flex flex-wrap gap-2 pt-2">
          {proofSections.map((sec) => (
            <a
              href={`#${sec.id}`}
              class="pill text-xs font-semibold hover:border-emerald-500 transition-colors"
            >
              <span>{sec.category}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- 5 Clearly Labeled Showcase Cards with Image Placeholders -->
      <div class="space-y-8">
        {proofSections.map((sec, idx) => (
          <article id={sec.id} class="halo scroll-mt-20" data-halo>
            <div class="halo-glow" aria-hidden="true"></div>
            <div class="glass p-6 sm:p-8 rounded-2xl space-y-6">
              <div class="halo-spot" aria-hidden="true"></div>

              <!-- Top Section Header -->
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400">
                      PROOF 0{idx + 1}
                    </span>
                    <span class="badge text-xs font-bold text-emerald-700 dark:text-emerald-400">
                      {sec.badge}
                    </span>
                  </div>

                  <h3 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-zinc-100">
                    {sec.title}
                  </h3>

                  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
                    {sec.subtitle}
                  </p>
                </div>

                <!-- Primary Metric Card -->
                <div class="shrink-0 p-3 sm:p-4 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-left sm:text-right">
                  <span class="block text-xl sm:text-2xl font-black text-emerald-700 dark:text-emerald-400">
                    {sec.metric}
                  </span>
                  <span class="block text-[11px] font-medium text-zinc-600 dark:text-zinc-400">
                    {sec.metricLabel}
                  </span>
                </div>
              </div>

              <!-- 📷 Main Image Placeholder Frame -->
              <div class="space-y-2">
                <div class="relative overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-950/40 group">
                  <!-- Clickable screenshot trigger -->
                  <button
                    type="button"
                    class="block w-full text-left focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-zoom-in"
                    data-zoom-img={sec.image}
                    data-zoom-title={sec.title}
                    data-zoom-caption={`${sec.category} · ${sec.metricLabel}`}
                    aria-label={`Inspect full size screenshot for ${sec.title}`}
                  >
                    <!-- 16:10 / 16:9 responsive frame -->
                    <div class="aspect-16/10 sm:aspect-16/9 w-full overflow-hidden bg-zinc-950">
                      <img
                        src={sec.image}
                        alt={sec.alt}
                        loading="lazy"
                        class="size-full object-contain sm:object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      />
                    </div>

                    <!-- Hover Expand Prompt -->
                    <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 backdrop-blur-[2px] transition-opacity group-hover:opacity-100">
                      <span class="btn btn-primary h-9 px-4 rounded-xl text-xs font-semibold shadow-xl">
                        <span class="btn-content inline-flex items-center gap-2">
                          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/>
                          </svg>
                          View High-Resolution Screenshot
                        </span>
                      </span>
                    </div>
                  </button>
                </div>

                <!-- Replacement Instructions / Helper Bar -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-1 text-xs text-zinc-500">
                  <div class="flex items-center gap-2">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span>Ready to upload: Replace <code class="font-mono text-[11px] text-emerald-700 dark:text-emerald-400 bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded">{sec.image}</code></span>
                  </div>

                  <button
                    type="button"
                    class="self-start sm:self-auto font-medium text-emerald-700 dark:text-emerald-400 hover:underline inline-flex items-center gap-1 cursor-pointer"
                    data-zoom-img={sec.image}
                    data-zoom-title={sec.title}
                    data-zoom-caption={`${sec.category} · ${sec.metricLabel}`}
                  >
                    <span>Click to expand image</span>
                    <span>↗</span>
                  </button>
                </div>
              </div>

              <!-- Descriptive Context -->
              <p class="text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
                {sec.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SEO Framework & Methodology Banner -->
    <section class="card-raised p-6 sm:p-8 space-y-4">
      <h2 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <svg class="size-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        The 4-Pillar Organic Growth Framework
      </h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Every campaign I manage follows a structured, repeatable standard operating procedure (SOP) that delivers compound visibility:
      </p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 pt-2">
        <div class="p-4 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">01. Audit</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">Technical Foundation</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">Crawl budget, Core Web Vitals, Schema.org implementation, and indexation hygiene.</p>
        </div>

        <div class="p-4 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">02. Authority</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">Topical Clusters</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">Mapping semantic entities and search intent to establish unequivocal domain expertise.</p>
        </div>

        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">03. Dominance</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">Local & Conversion</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">Google Business Profile optimization, local citations, review strategy, and call conversions.</p>
        </div>

        <div class="p-4 rounded-xl bg-zinc-100/70 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">04. AI Search</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">AEO & GEO Ready</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">Structuring brand knowledge graph data to ensure recommendations in ChatGPT, Claude, and AI Overviews.</p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="p-6 rounded-2xl bg-zinc-900 text-white dark:bg-zinc-800 dark:text-zinc-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold">Have a client or project requiring similar growth?</h3>
        <p class="text-xs text-zinc-400 mt-1">Let’s discuss your target keywords, competitors, and growth objectives.</p>
      </div>
      <a
        href="/contact"
        data-sfx="pop"
        class="btn btn-primary h-10 px-5 rounded-xl text-xs font-semibold whitespace-nowrap"
      >
        <span class="btn-content">Book a Consultation</span>
      </a>
    </div>
  </div>

  <!-- Fullscreen Lightbox Modal for Screenshots -->
  <dialog id="screenshot-lightbox" class="fixed inset-0 z-50 m-auto max-w-5xl w-[92vw] rounded-2xl bg-zinc-950/95 p-4 sm:p-6 text-white backdrop:bg-black/80 backdrop-blur-md border border-zinc-800 shadow-2xl outline-none">
    <div class="relative flex flex-col items-center space-y-3">
      <div class="flex w-full items-center justify-between border-b border-zinc-800/80 pb-3">
        <div>
          <h4 id="lightbox-title" class="text-sm sm:text-base font-bold text-zinc-100"></h4>
          <p id="lightbox-caption" class="text-xs text-emerald-400 font-mono mt-0.5"></p>
        </div>
        <button id="lightbox-close" type="button" class="btn btn-secondary size-9 rounded-full text-sm font-bold text-zinc-400 hover:text-white" aria-label="Close modal">
          ✕
        </button>
      </div>

      <div class="w-full flex justify-center py-2">
        <img id="lightbox-img" src="" alt="Screenshot" class="max-h-[75vh] w-auto rounded-xl border border-zinc-800 object-contain shadow-2xl" />
      </div>

      <div class="w-full text-center pt-1 border-t border-zinc-800/60">
        <p class="text-[11px] text-zinc-400">
          Press <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-300 font-mono">ESC</kbd> or click anywhere outside to close.
        </p>
      </div>
    </div>
  </dialog>

  <script>
    function setupLightbox() {
      const dialog = document.getElementById('screenshot-lightbox') as HTMLDialogElement | null;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxCaption = document.getElementById('lightbox-caption');
      const closeBtn = document.getElementById('lightbox-close');

      if (!dialog) return;

      document.querySelectorAll<HTMLElement>('[data-zoom-img]').forEach((trigger) => {
        if (trigger.dataset.lightboxBound) return;
        trigger.dataset.lightboxBound = 'true';

        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const src = trigger.getAttribute('data-zoom-img');
          const title = trigger.getAttribute('data-zoom-title') || 'Screenshot Verification';
          const caption = trigger.getAttribute('data-zoom-caption') || '';

          if (lightboxImg && src) lightboxImg.src = src;
          if (lightboxTitle) lightboxTitle.textContent = title;
          if (lightboxCaption) lightboxCaption.textContent = caption;

          dialog.showModal();
        });
      });

      closeBtn?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }

    setupLightbox();
    document.addEventListener('astro:after-swap', setupLightbox);
  </script>
</BaseLayout>
