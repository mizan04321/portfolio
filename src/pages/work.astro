---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SlatsCover from '../components/SlatsCover.astro';

const caseStudies = [
  {
    title: "Digital Products E-Commerce Growth (Shopify)",
    client: "Fanflix BD (Dhaka, Bangladesh)",
    metric: "300 → 1.9K+ Clicks",
    timeframe: "3 Months",
    tags: ["Shopify", "E-Commerce SEO", "Technical Audit", "Keyword Intent"],
    description: "Scaled a Shopify-based e-commerce store selling digital products from virtually zero search traffic to over 1,900 monthly organic clicks.",
    bullets: [
      "Conducted extensive search intent mapping to align commercial keywords with category and product URLs.",
      "Fixed crawl bloat, collection filter indexation, and implemented automated Product/Offer schema.",
      "Optimized product descriptions, meta tags, and internal link architecture to pass topical equity."
    ]
  },
  {
    title: "Multi-Location Healthcare SEO (7 Google Business Profiles)",
    client: "Confidential Healthcare Provider (UK)",
    metric: "7 GBPs Ranked Top 3",
    timeframe: "Ongoing Agency Lead",
    tags: ["Local SEO", "Multi-Location", "Google Business Profile", "Healthcare"],
    description: "Managed end-to-end local SEO for a UK-based healthcare business operating across 7 regional Google Business Profiles.",
    bullets: [
      "Standardized NAP (Name, Address, Phone) citations and implemented location-specific semantic entity signals.",
      "Built dedicated clinic service landing pages with local business schema connected directly to each GBP.",
      "Achieved dominant Google Maps 3-Pack visibility across primary UK target service areas, driving record patient inquiries."
    ]
  },
  {
    title: "UK Taxi Service: Technical SEO & Toxic Backlink Recovery",
    client: "Ramies Taxi (UK)",
    metric: "3× Organic Surge · Top 5 Rank",
    timeframe: "Jan 2025 – Jun 2025",
    tags: ["Technical SEO", "Penalty Recovery", "Screaming Frog", "Backlink Disavow"],
    description: "Diagnosed algorithmic suppression caused by legacy negative SEO attacks and technical site deficiencies.",
    bullets: [
      "Audited link profile with Semrush and GSC, identifying and preparing disavow documentation for 300+ toxic backlinks.",
      "Resolved Core Web Vitals bottlenecks, mobile layout shifts, and XML sitemap indexation conflicts.",
      "Reclaimed lost rankings, moving competitive regional taxi keywords from page 2 (10+ positions) into top 5 organic results."
    ]
  },
  {
    title: "Local SEO Lead Generation: UK Pharmacy & Houston Landscaping",
    client: "Local Service Businesses (UK & USA)",
    metric: "1,200+ Calls (UK) · 330 Calls/Mo (US)",
    timeframe: "Jan 2023 – Present",
    tags: ["Local SEO", "High-Intent Calls", "GBP Domination", "Conversion SEO"],
    description: "Implemented high-converting local search strategies built specifically to turn Google Maps searchers into immediate phone calls.",
    bullets: [
      "UK Pharmacy: Optimized categories, services, products, and Q&A to generate 1,200+ verified customer calls within 6 months.",
      "Houston Landscaping: Structured local radius citations and seasonal service clusters, delivering 330 calls in a single month.",
      "Oldham Chiropody Clinic: Overhauled underdeveloped GBP profile, securing direct booking appointments via Google profile actions."
    ]
  }
];
---

<BaseLayout
  title="Case Studies & Results · Md. Mizanur Rahaman"
  description="Proven SEO case studies: 300 to 1.9K+ Shopify clicks, 1,200+ calls for UK pharmacy, 300+ toxic backlink recovery, and multi-location GBP domination."
  currentPath="/work"
>
  <Header />
  <SlatsCover />

  <!-- Page Header Title -->
  <section class="px-4 pt-8 text-center sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Case Studies & Measurable Growth
    </h1>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
      Real client results demonstrating organic search revenue, Google Business Profile growth, and technical precision.
    </p>
  </section>

  <!-- Profile Tabs -->
  <nav class="mt-8 border-b border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 lg:px-8" aria-label="Profile tabs">
    <ul class="flex justify-center gap-8">
      <li>
        <a href="/" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Resume
        </a>
      </li>
      <li>
        <a href="/work" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-emerald-700 dark:text-emerald-400 border-b-2 border-emerald-600 dark:border-emerald-400">
          Case Studies & Results
        </a>
      </li>
      <li>
        <a href="/services" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Services
        </a>
      </li>
      <li>
        <a href="/contact" class="relative block py-3 text-xs sm:text-sm font-semibold tracking-wide uppercase text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Contact
        </a>
      </li>
    </ul>
  </nav>

  <!-- Case Studies Grid -->
  <div class="px-4 py-10 sm:px-6 lg:px-8 space-y-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {caseStudies.map((study) => (
        <article class="halo" data-halo>
          <div class="halo-glow" aria-hidden="true"></div>
          <div class="glass p-6 rounded-2xl h-full flex flex-col justify-between space-y-4">
            <div class="halo-spot" aria-hidden="true"></div>
            <div>
              <div class="flex items-start justify-between gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
                  {study.client}
                </span>
                <span class="badge text-xs font-bold text-emerald-700 dark:text-emerald-400">
                  {study.timeframe}
                </span>
              </div>

              <h2 class="mt-2 text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                {study.title}
              </h2>

              <div class="mt-3 p-3 rounded-xl bg-emerald-500/10 dark:bg-emerald-950/40 border border-emerald-500/20">
                <p class="text-xs font-semibold text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5">
                  <svg class="size-4 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                    <polyline points="16 7 22 7 22 13"/>
                  </svg>
                  Key Outcome: <span class="font-extrabold text-sm">{study.metric}</span>
                </p>
              </div>

              <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {study.description}
              </p>

              <ul class="mt-3 space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 list-disc pl-5">
                {study.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-200 dark:border-zinc-800">
              {study.tags.map((tag) => (
                <span class="rounded-md bg-zinc-100 dark:bg-zinc-800/80 px-2 py-0.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-400">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- SEO Framework & Methodology Banner -->
    <section class="card-raised p-6 sm:p-8 space-y-4">
      <h2 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
        <svg class="size-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        The 4-Pillar Organic Growth Framework
      </h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Every campaign I manage follows a structured, repeatable standard operating procedure (SOP) that delivers compound visibility:
      </p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 pt-2">
        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">01. Audit</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">Technical Foundation</h3>
          <p class="text-xs text-zinc-500 mt-1">Crawl budget, Core Web Vitals, Schema.org implementation, and indexation hygiene.</p>
        </div>

        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">02. Authority</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">Topical Clusters</h3>
          <p class="text-xs text-zinc-500 mt-1">Mapping semantic entities and search intent to establish unequivocal domain expertise.</p>
        </div>

        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">03. Dominance</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">Local & Conversion</h3>
          <p class="text-xs text-zinc-500 mt-1">Google Business Profile optimization, local citations, review strategy, and call conversions.</p>
        </div>

        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
          <span class="text-emerald-600 dark:text-emerald-400 font-black text-sm">04. AI Search</span>
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 mt-1">AEO & GEO Ready</h3>
          <p class="text-xs text-zinc-500 mt-1">Structuring brand knowledge graph data to ensure recommendations in ChatGPT, Claude, and AI Overviews.</p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="p-6 rounded-2xl bg-zinc-900 text-white dark:bg-zinc-800 dark:text-zinc-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold">Have a client or project requiring similar growth?</h3>
        <p class="text-xs text-zinc-400 mt-1">Let’s discuss your target keywords, competitors, and growth objectives.</p>
      </div>
      <a
        href="/contact"
        data-sfx="pop"
        class="btn btn-primary h-10 px-5 rounded-xl text-xs font-semibold whitespace-nowrap"
      >
        <span class="btn-content">Book a Consultation</span>
      </a>
    </div>
  </div>
</BaseLayout>
